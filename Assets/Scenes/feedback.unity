  texts:
    back: "\u0E22\u0E49\u0E2D\u0E19|\u0E01\u0E25\u0E31\u0E1A"
    next: "\u0E16\u0E31\u0E14|\u0E44\u0E1B"
    send: "\u0E2A\u0E48\u0E07|\u0E04\u0E33|\u0E15\u0E2D\u0E1A"
    answerFirst: "\u0E15\u0E2D\u0E1A|\u0E02\u0E49\u0E2D|\u0E19\u0E35\u0E49|\u0E01\u0E48\u0E2D\u0E19"
    goToRemaining: "\u0E02\u0E49\u0E2D|\u0E17\u0E35\u0E48|\u0E22\u0E31\u0E07|\u0E40\u0E2B\u0E25\u0E37\u0E2D"
    selectedCount: "\u0E40\u0E25\u0E37\u0E2D\u0E01|\u0E41\u0E25\u0E49\u0E27 {count}
      \u0E02\u0E49\u0E2D"
    remaining: "\u0E22\u0E31\u0E07|\u0E40\u0E2B\u0E25\u0E37\u0E2D|\u0E2D\u0E35\u0E01
      {count} \u0E04\u0E33\u0E16\u0E32\u0E21"
    allAnswered: "\u0E04\u0E23\u0E1A|\u0E41\u0E25\u0E49\u0E27"
    scaleHint: "\u0E40\u0E25\u0E37\u0E2D\u0E01 1 \u0E23\u0E30\u0E14\u0E31\u0E1A"
    singleHint: "\u0E40\u0E25\u0E37\u0E2D\u0E01 1 \u0E02\u0E49\u0E2D"
    optionalTag: " (\u0E44\u0E21\u0E48|\u0E1A\u0E31\u0E07\u0E04\u0E31\u0E1A)"
    multiHintMin: "\u0E40\u0E25\u0E37\u0E2D\u0E01|\u0E2D\u0E22\u0E48\u0E32\u0E07|\u0E19\u0E49\u0E2D\u0E22
      {min} \u0E02\u0E49\u0E2D"
    multiHintRange: "\u0E40\u0E25\u0E37\u0E2D\u0E01 {min} - {max} \u0E02\u0E49\u0E2D"
    textHint: "\u0E1E\u0E34\u0E21\u0E1E\u0E4C|\u0E04\u0E33|\u0E15\u0E2D\u0E1A|\u0E44\u0E14\u0E49|\u0E2D\u0E34\u0E2A\u0E23\u0E30"
    textPlaceholder: "\u0E40\u0E0A\u0E48\u0E19|\u0E2D\u0E22\u0E32\u0E01|\u0E43\u0E2B\u0E49|\u0E21\u0E35|\u0E40\u0E21\u0E37\u0E2D\u0E07|\u0E43\u0E2B\u0E21\u0E48
      \u0E40\u0E21\u0E19\u0E39|\u0E43\u0E2B\u0E21\u0E48 \u0E2B\u0E23\u0E37\u0E2D|\u0E41\u0E15\u0E48\u0E07|\u0E23\u0E49\u0E32\u0E19|\u0E44\u0E14\u0E49..."
    otherPlaceholder: "\u0E23\u0E30\u0E1A\u0E38|\u0E2A\u0E31\u0E49\u0E19\u0E46..."
    confirmTitle: "\u0E15\u0E49\u0E2D\u0E07|\u0E01\u0E32\u0E23|\u0E2A\u0E48\u0E07|\u0E04\u0E33|\u0E15\u0E2D\u0E1A|\u0E40\u0E25\u0E22|\u0E44\u0E2B\u0E21?"
    confirmMessage: "\u0E16\u0E49\u0E32|\u0E2A\u0E48\u0E07|\u0E41\u0E25\u0E49\u0E27|\u0E08\u0E30|\u0E01\u0E25\u0E31\u0E1A|\u0E21\u0E32|\u0E41\u0E01\u0E49|\u0E04\u0E33|\u0E15\u0E2D\u0E1A|\u0E44\u0E21\u0E48|\u0E44\u0E14\u0E49|\u0E19\u0E30"
